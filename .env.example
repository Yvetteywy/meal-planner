# Environment variables for Meal Planner
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# --- AI / Recipe Recommendation ---
# Used to power the AI recipe recommendation feature.
# Obtain a key from https://platform.openai.com/
OPENAI_API_KEY=

# --- Future: Shopping Integrations ---
# Keys for third-party shopping APIs (Amazon, Instacart, etc.)
# AMAZON_API_KEY=
# INSTACART_API_KEY=

# --- Future: Database (if you migrate away from localStorage) ---
# DATABASE_URL=
